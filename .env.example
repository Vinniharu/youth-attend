# Copy to .env and fill in. Never commit .env.

# Database
# DB_PASSWORD must match the password in DATABASE_URL. Postgres keeps the password
# it was first initialised with; changing it later needs `docker compose down -v`.
# Use a URL-safe password (it is embedded in DATABASE_URL): openssl rand -hex 24
DB_PASSWORD=change-me
# Host port for the dev database (change if 5432 is taken; keep DATABASE_URL in sync)
DB_PORT=5432
DATABASE_URL=postgres://church:change-me@localhost:5432/attendance

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to call /api/auth (comma-separated), e.g. the Docker app or
# Playwright port in development. APP_URL is always trusted.
BETTER_AUTH_TRUSTED_ORIGINS=
SEED_ADMIN_EMAIL=you@example.com

# Email (Resend API key, "Sending access": https://resend.com/api-keys)
# Leave empty in development: sign-in codes are printed to the server console.
# EMAIL_FROM must use a domain verified in Resend (Domains).
RESEND_API_KEY=
EMAIL_FROM="Youth Church <noreply@yourdomain.org>"
ADMIN_ALERT_EMAILS=pastor@yourdomain.org,youthlead@yourdomain.org

# Jobs and tokens (generate with: openssl rand -base64 32)
CRON_SECRET=
UNSUBSCRIBE_SECRET=
APP_URL=http://localhost:3000
APP_INTERNAL_URL=http://localhost:3000
# Host port for the Docker app container (dev compose only)
APP_PORT=3000

# Behaviour
APP_TIMEZONE=Africa/Lagos
MAX_ACCURACY_M=75
# QR check-ins accept rougher GPS (the code proves presence); default 2 x MAX_ACCURACY_M
# QR_MAX_ACCURACY_M=150
QR_WINDOW_SECONDS=30
ABSENCE_FLAG_THRESHOLD=3
LOCATION_RETENTION_DAYS=90
DEFAULT_SERVICE_START=08:00
DEFAULT_SERVICE_END=11:30

# Production only (docker-compose.prod.yml): the app's domain; Caddy gets HTTPS for it
DOMAIN=attendance.yourdomain.org
# Nightly database backups into ./backups (local time, APP_TIMEZONE)
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30
# Shared server (other sites behind an existing nginx/Caddy; docs/DEPLOY-SHARED.md):
# uncomment both so plain `docker compose …` adds docker-compose.shared.yml, and set
# APP_PORT to the loopback port your proxy forwards to (e.g. 3061).
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:docker-compose.shared.yml
# COMPOSE_PROJECT_NAME=pulse-attend
# If the server's proxy runs in Docker, also append :docker-compose.proxy-network.yml
# to COMPOSE_FILE and set PROXY_NETWORK to that container's network (step 6C).
# PROXY_NETWORK=zylo_default
